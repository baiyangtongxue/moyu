<Window x:Class="MoyuPopup.Presentation.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480" Height="520"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        Background="#FF25272B">
    <Window.Resources>
        <!-- 统一控件样式：保证各选项卡视觉一致 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCD2D9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FF1B1D21"/>
            <Setter Property="Foreground" Value="#FFE8EAED"/>
            <Setter Property="BorderBrush" Value="#FF3A3F46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9FB1C9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="CheckItem" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8EAED"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A919C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- 常规 -->
            <TabItem Header="常规" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启（当前用户，静默启动进广告态）" Style="{StaticResource CheckItem}"/>
                        <CheckBox x:Name="ChkStartInAd" Content="启动后先进入广告伪装态" Style="{StaticResource CheckItem}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="开机自启写入 HKCU 注册表（仅当前用户，免管理员）；启动后默认停在广告伪装态，等候悬停。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 窗口 -->
            <TabItem Header="窗口" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">

                        <TextBlock Text="尺寸 (DIP)" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="宽度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtWidth" Grid.Column="1" Margin="0,4,10,4" Style="{StaticResource FieldInput}"/>
                            <TextBlock Grid.Column="2" Text="高度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtHeight" Grid.Column="3" Margin="0,4" Style="{StaticResource FieldInput}"/>
                        </Grid>

                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="不透明度" Width="110" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldOpacity" Width="180" Minimum="0.4" Maximum="1"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblOpacity" Text="0.95" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkTopmost" Content="窗口置顶" Style="{StaticResource CheckItem}"/>
                            <CheckBox x:Name="ChkTransparentMode" Content="透明模式（近乎隐身，悬停/拖动仅此区域）" Style="{StaticResource CheckItem}"/>
                        </StackPanel>

                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="悬停延时 (ms)" Width="110" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtHoverDelay" Width="80" Style="{StaticResource FieldInput}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkPauseOnLeave" Content="鼠标移开暂停视频" Style="{StaticResource CheckItem}"/>
                            <CheckBox x:Name="ChkRememberPos" Content="记忆窗口位置" Style="{StaticResource CheckItem}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="透明模式下窗口近乎不可见：把光标移进该区域（右下角或记忆位置）即可唤起视频；在区域内按住左键可拖动定位。"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 热键 -->
            <TabItem Header="热键" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="点击输入框后按下新组合键（需至少含 Ctrl/Alt/Shift/Win 之一）。建议用符号键，避开显卡屏幕旋转的 Ctrl+Alt+方向键冲突。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="老板键" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkToggle" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}"
                                     PreviewKeyDown="OnHotkeyKeyDown" ToolTip="点击后按下新组合键（需含 Ctrl/Alt/Shift/Win）"/>
                            <TextBlock Grid.Row="1" Text="下一集" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkNext" Grid.Row="1" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                            <TextBlock Grid.Row="2" Text="上一集" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkPrev" Grid.Row="2" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                            <TextBlock Grid.Row="3" Text="播放/暂停" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkPlayPause" Grid.Row="3" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                            <TextBlock Grid.Row="4" Text="音量 +" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkVolUp" Grid.Row="4" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                            <TextBlock Grid.Row="5" Text="音量 -" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkVolDown" Grid.Row="5" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                            <TextBlock Grid.Row="6" Text="上班锁定" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HkLockAd" Grid.Row="6" Grid.Column="1" Margin="10,3,0,3" IsReadOnly="True"
                                     Style="{StaticResource FieldInput}" PreviewKeyDown="OnHotkeyKeyDown"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 视频源 -->
            <TabItem Header="视频源" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="启用平台（custom 永远兜底）" Style="{StaticResource SectionTitle}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="ChkBilibili" Content="哔哩哔哩（官方嵌入）" Style="{StaticResource CheckItem}"/>
                        <CheckBox x:Name="ChkTencent" Content="腾讯视频（官方嵌入）" Style="{StaticResource CheckItem}"/>
                        <CheckBox x:Name="ChkDouyin" Content="抖音（网页适配，页面改版需跟进）" Style="{StaticResource CheckItem}"/>
                        <CheckBox x:Name="ChkIqiyi" Content="爱奇艺（网页适配）" Style="{StaticResource CheckItem}"/>
                        <TextBlock Text="登录" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkLoginEnabled" Content="启用登录窗口（登录信息仅保存在本机）" Style="{StaticResource CheckItem}"/>
                        <Button x:Name="BtnLogin" Content="打开登录窗口…" Width="130" Height="28"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenLogin"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="随机视频/热门为免登录；观看历史、稍后再看需登录后获取。目前仅哔哩哔哩提供干净的公开列表接口。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 广告 -->
            <TabItem Header="广告" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="轮播间隔 (秒)" Width="110" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtAdInterval" Width="80" Style="{StaticResource FieldInput}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAdShuffle" Content="随机顺序轮播" Style="{StaticResource CheckItem}" Margin="0,12,0,0"/>
                        <Button x:Name="BtnOpenAds" Content="打开广告素材目录…" Width="150" Height="28"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnOpenAdsDir"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="目录为空时使用内置兜底素材；支持 png/jpg 图片。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="关于" Foreground="#FFE8EAED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <TextBlock x:Name="LblVersion" Text="广告弹窗投放 v0.1.0" Foreground="#FFE8EAED"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="本工具仅供个人在本地学习研究使用，视频内容来自第三方平台的公开网页，请遵守各平台用户协议；请勿在需要高度专注的工作环境中使用。零上报，所有数据仅保存在本机。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="76" Height="28" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
