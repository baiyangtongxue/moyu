<Window x:Class="MoyuPopup.Presentation.UrlInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入视频链接"
        Width="480" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="#FF25272B">
    <StackPanel Margin="16">
        <TextBlock Text="粘贴视频链接（B 站 / 腾讯视频 / 任意网页地址），悬停弹窗即播"
                   Foreground="#FFCCD2D9" FontSize="12" Margin="0,0,0,10"/>
        <TextBox x:Name="UrlBox" Height="32" VerticalContentAlignment="Center"
                 Background="#FF1B1D21" Foreground="#FFE8EAED" BorderBrush="#FF3A3F46"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="76" Height="28" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="76" Height="28" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
