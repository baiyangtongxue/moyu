<Window x:Class="MoyuPopup.Presentation.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:car="clr-namespace:MoyuPopup.Presentation"
        Title="广告推广"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="424" Height="249">

    <!-- 外层 Grid 留出阴影空间；内层 Border 圆角 + 阴影，模拟系统弹窗观感 -->
    <Grid Margin="12">
        <Border x:Name="RootBorder"
                CornerRadius="8"
                Background="#FF14161A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35"/>
            </Border.Effect>

            <!-- 内容区：广告轮播层 / 播放层 按状态互斥显隐 -->
            <Grid x:Name="ContentClip" SizeChanged="OnContentSizeChanged">
                <car:AdCarouselControl x:Name="AdLayer"/>

                <!-- 播放层：WebView2 宿主（M2）+ 提示/引导层（WebView 就绪前显示） -->
                <Border x:Name="PlayLayer" Background="#FF101418" Visibility="Collapsed">
                    <Grid>
                        <Grid x:Name="WebViewHost"/>
                        <TextBlock x:Name="PlayHint"
                                   Foreground="#FF666F7A" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- 迷你工具条：悬停 1s 淡入、3s 无操作淡出（M4，设计书 6.3） -->
                        <Border x:Name="MiniBar"
                                Height="36"
                                CornerRadius="6"
                                Background="#CC101418"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"
                                Opacity="0"
                                Visibility="Collapsed"
                                MouseMove="OnMiniBarMouseMove">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <Button x:Name="BtnPrev" Content="⏮" Width="30" Height="26"
                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                        FontSize="14" Click="OnPrevClick" ToolTip="上一集"/>
                                <Button x:Name="BtnPlay" Content="⏯" Width="30" Height="26" Margin="4,0"
                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                        FontSize="14" Click="OnPlayPauseClick" ToolTip="播放/暂停"/>
                                <Button x:Name="BtnNext" Content="⏭" Width="30" Height="26"
                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                        FontSize="14" Click="OnNextClick" ToolTip="下一集"/>
                                <TextBlock Text="🔊" FontSize="13" Foreground="White"
                                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
                                <Button x:Name="BtnHide" Content="隐藏" Width="42" Height="26" Margin="10,0,0,0"
                                        Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                        FontSize="12" Click="OnHideClick" ToolTip="隐藏窗口（老板键）"/>
                            </StackPanel>
                        </Border>

                        <!-- 播放态右上角关闭按钮（老板键），与广告层假 ✘ 一致，始终可见 -->
                        <Border x:Name="PlayCloseBtn"
                                Width="22" Height="22" CornerRadius="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,6,6,0" Cursor="Hand"
                                MouseLeftButtonUp="OnPlayCloseClick"
                                ToolTip="隐藏窗口（老板键）">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#44000000"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#88000000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="✕" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
