<Window x:Class="MoyuPopup.Presentation.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="素材清单"
        Width="480" Height="380"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#FF25272B">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：链接输入 + 添加 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="添加" Width="64" Height="30"
                    Margin="8,0,0,0" Click="OnAdd"/>
            <TextBox x:Name="UrlBox" Height="30" VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Background="#FF1B1D21" Foreground="#FFE8EAED" BorderBrush="#FF3A3F46"
                     KeyDown="OnUrlKeyDown"/>
        </DockPanel>

        <!-- 中部：队列列表（双击播放，▶ 标记当前条目） -->
        <ListView x:Name="QueueList" Grid.Row="1"
                  Background="#FF1B1D21" BorderBrush="#FF3A3F46" BorderThickness="1"
                  Foreground="#FFE8EAED"
                  MouseDoubleClick="OnItemDoubleClick"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="标题" Width="250"
                                    DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="平台" Width="70"
                                    DisplayMemberBinding="{Binding Platform}"/>
                    <GridViewColumn Header="进度" Width="80"
                                    DisplayMemberBinding="{Binding PositionText}"/>
                    <GridViewColumn Header="当前" Width="44"
                                    DisplayMemberBinding="{Binding CurrentMark}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 底部：移除 / 清空 + 提示 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="移除选中" Width="76" Height="28" Click="OnRemove"/>
                <Button Content="清空" Width="64" Height="28" Margin="8,0,0,0" Click="OnClear"/>
            </StackPanel>
            <TextBlock Text="双击条目立即播放 · Ctrl+Alt+←/→ 快速切集"
                       Foreground="#FF8A919C" FontSize="11"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
