<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AdPopup</AssemblyName>
    <RootNamespace>MoyuPopup</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <AssemblyTitle>骞垮憡寮圭獥鎶曟斁</AssemblyTitle>
    <Product>AdPopup</Product>
    <!-- 鑷畾涔夊叆鍙ｏ細杩愯 Velopack 閽╁瓙鍚庡啀鍚姩 WPF锛圡5 鎵撳寘鑷姩鏇存柊锛?-->
    <StartupObject>MoyuPopup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- 绉婚櫎 UseWindowsForms 娉ㄥ叆鐨勯殣寮?using锛岄伩鍏嶄笌 WPF 绫诲瀷锛圓pplication/Color/Point/Image锛変簩涔夋€?-->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- 闅忓寘鍒嗗彂 WebView2 Evergreen 寮曞鍣細鐩爣鏈虹己澶辨椂鑷姩杩愯瀹夎锛圡5锛?-->
  <ItemGroup>
    <None Include="WebView2RuntimeInstaller.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
